{
 "name": "GroupChatOn",
 "short_name": "GroupChatOn",
 "id": "/",
 "description": "Read every GroupChatOn novel: follow your favourites, continue where you stopped and read chapters offline.",
 "start_url": "/?source=pwa",
 "scope": "/",
 "display": "standalone",
 "display_override": ["standalone", "minimal-ui"],
 "launch_handler": { "client_mode": "focus-existing" },
 "orientation": "any",
 "background_color": "#fbfaf7",
 "theme_color": "#2c8a3a",
 "lang": "en",
 "dir": "ltr",
 "categories": ["books", "entertainment"],
 "icons": [
  { "src": "/brand/favicon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
  { "src": "/brand/favicon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
  { "src": "/brand/app-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
  { "src": "/brand/app-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
 ],
 "screenshots": [
  { "src": "/brand/shot-phone-home.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Novels and latest chapters" },
  { "src": "/brand/shot-phone-read.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Reading a chapter in sepia" },
  { "src": "/brand/shot-wide.png", "sizes": "1600x1000", "type": "image/png", "form_factor": "wide", "label": "GroupChatOn on a computer" }
 ],
 "shortcuts": [
  { "name": "Library", "short_name": "Library", "url": "/library/", "icons": [{ "src": "/brand/favicon-192.png", "sizes": "192x192" }] },
  { "name": "Search", "short_name": "Search", "url": "/search/", "icons": [{ "src": "/brand/favicon-192.png", "sizes": "192x192" }] }
 ]
}
